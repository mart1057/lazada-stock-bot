# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Bangkok

# ---------------------------------------------------------------------------
# Telegram
# 1. @BotFather -> /newbot -> copy the token
# 2. Open the bot in Telegram and press Start (a bot cannot message you first)
# 3. Chat id: https://api.telegram.org/bot<TOKEN>/getUpdates -> message.chat.id
#    Several chats: comma separated.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = log the message instead of sending it
TELEGRAM_DRY_RUN=false

# ---------------------------------------------------------------------------
# Lazada
#   LAZADA_PRODUCTS : `Name|PDP url` entries separated by `;`.
#                     Short links (s.lazada.co.th/...) work too - the browser
#                     follows the redirect - but a full /products/...-i<item>-s<sku>.html
#                     url is faster and more stable.
#   LAZADA_SKU_IDS  : only watch these SKUs (comma separated). Empty = every
#                     colour / capacity on the page. Run `npm run check` to see ids.
# ---------------------------------------------------------------------------
LAZADA_PRODUCTS=iPhone Duo|https://www.lazada.co.th/products/-i16250067859-s127511251733.html
LAZADA_SKU_IDS=

# ---------------------------------------------------------------------------
# Browser (Playwright)
# Lazada only answers stock to its own signed web client, so the bot reads the
# product page in a real browser instead of calling the API directly.
#   BROWSER_CHANNEL : chrome = use the Google Chrome you already have installed.
#                     Empty  = Playwright's Chromium (run `npm run browser:install` once)
#   HEADLESS        : false shows the window - use it if Lazada asks for a
#                     slider check; solve it once and the profile remembers it.
#   PAGE_RELOAD_MINUTES : full page reload interval; between reloads the bot
#                     re-asks the already-open page, which is much lighter.
# ---------------------------------------------------------------------------
BROWSER_CHANNEL=chrome
HEADLESS=true
BROWSER_PROFILE_DIR=.browser-profile
PAGE_TIMEOUT_MS=45000
PAGE_RELOAD_MINUTES=20

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Gap between the END of one check and the START of the next
STOCK_CHECK_INTERVAL_SECONDS=30
RUN_ON_STARTUP=true
# Last known stock per SKU (survives restarts, keeps the first run quiet)
STATE_FILE=data/state.json

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
# A restock alert is sent this many times, ALERT_COPY_GAP_SECONDS apart
ALERT_COPIES=2
ALERT_COPY_GAP_SECONDS=3
# Telegram notice when Lazada blocks the bot / when it recovers
SYSTEM_ALERTS_ENABLED=true
SYSTEM_ALERT_MIN_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Cooldown when Lazada blocks (captcha / FAIL_SYS_USER_VALIDATE / ...)
# BASE seconds, doubled on every further block, capped at MAX.
# ---------------------------------------------------------------------------
COOLDOWN_BASE_SECONDS=120
COOLDOWN_MAX_SECONDS=1800

# Telegram HTTP
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
